# Grav cache, backups, logs, and temporary files
/assets/*
!/assets/.gitkeep
/backup/*
!/backup/.gitkeep
/cache/*
!/cache/.gitkeep
/images/*
!/images/.gitkeep
/logs/*
!/logs/.gitkeep
/tmp/*
!/tmp/.gitkeep

# Environment files
.env
.env.local
*.log
*.tmp
*.bak
user/data/grav-security-probe.*
user/data/feed/
user/data/notifications/

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
